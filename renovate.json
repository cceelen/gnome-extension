{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Actions: a new version is not taken before it has been out for three days.",
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The images of the Shell test, pinned by digest: the updates of tags and digests together in one pull request.",
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "groupName": "container images"
    }
  ]
}
